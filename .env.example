# Local development defaults. On Render, set DB_FILE=/var/data/kitbench.sqlite if using a persistent disk mounted at /var/data.
PORT=3000
NODE_ENV=production
# Use the exact origin of your GitHub Pages site, e.g. https://YOUR-USERNAME.github.io (no repository path)
FRONTEND_ORIGIN=https://YOUR-USERNAME.github.io
DB_FILE=kitbench.sqlite
# Generate unique random secrets at least 32 characters long; never use these placeholder values.
JWT_SECRET=replace_with_a_unique_random_secret_at_least_32_chars
OTP_SECRET=replace_with_a_different_random_secret_at_least_32_chars
ADMIN_API_TOKEN=replace_with_a_third_unique_random_admin_token_at_least_32_chars

# SMTP credentials from your email provider (needed for real verification emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password-or-app-password
MAIL_FROM=KitBench <no-reply@example.com>

# Optional Razorpay credentials. Start with test-mode keys only.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_with_server_secret
